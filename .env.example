# Replit AI Integrations configure AI_INTEGRATIONS_OPENAI_* automatically.
# For a local machine, set your own OpenAI-compatible endpoint and key here.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.4-mini

# Optional. Defaults to data/checkpoints.sqlite.
SPRINTPULSE_CHECKPOINT_DB=

# Optional semantic memory. Disabled unless every required setting/backend is ready.
MEM0_ENABLED=false
MEM0_PROJECT_ID=
# Must match runtime: published REPLIT_DEPLOYMENT=1 requires production;
# development/editor/local runs require development. Mismatches fail closed.
MEM0_ENVIRONMENT=
MEM0_TELEMETRY=false
MEM0_API_KEY=
# Optional dedicated ledger connection; otherwise use the runtime DATABASE_URL.
# Production requires a separately verified durable target, not the test database.
MEM0_LEDGER_DATABASE_URL=
